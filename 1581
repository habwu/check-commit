def solve():
    n = int(input())
    a = list(map(int, input().split()))

    result = []
    count = 1
    for i in range(1, n):
        if a[i] == a[i-1]:
            count += 1
        else:
            result.append(count)
            result.append(a[i-1])
            count = 1
    
    result.append(count)
    result.append(a[n-1])

    print(*result)

solve()
