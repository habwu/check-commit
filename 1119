import math
N, M = map(int, input().split())
K = int(input())
diagonal_blocks = set()
for _ in range(K):
    x, y = map(int, input().split())
    diagonal_blocks.add((x, y))
dp = [[float('inf')] * (M + 1) for _ in range(N + 1)]
dp[0][0] = 0
for i in range(N + 1):
    for j in range(M + 1):
        if i > 0:
            dp[i][j] = min(dp[i][j], dp[i - 1][j] + 100)
        if j > 0:
            dp[i][j] = min(dp[i][j], dp[i][j - 1] + 100)
        if i > 0 and j > 0 and (i, j) in diagonal_blocks:
            dp[i][j] = min(dp[i][j], dp[i - 1][j - 1] + 100 * math.sqrt(2))
result = round(dp[N][M])
print(result)
